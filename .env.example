# Secret used by Vercel Cron when calling /api/cron/crawl
CRON_SECRET=

# Public URL of the separately deployed FastAPI crawler service
CRAWLER_API_URL=

# Shared bearer token between Next.js and the FastAPI crawler
CRAWLER_API_TOKEN=

# FastAPI-only, comma-separated browser origins allowed by CORS
CRAWLER_ALLOWED_ORIGINS=http://localhost:3000
